#!/usr/bin/env ruby
# frozen_string_literal: true

require "bcrypt"
require "io/console"

$stderr.print "Password to hash: "
password = begin
  STDIN.noecho(&:gets)
rescue Errno::ENOTTY, IOError
  STDIN.gets
end.to_s.chomp
$stderr.puts

if password.empty?
  warn "Password cannot be empty."
  exit 1
end

# Only the hash goes to stdout - everything else above is on stderr - so
# `WEB_APP_PASSWORD_HASH=$(bin/hash_password)` captures just the hash.
puts BCrypt::Password.create(password)
