#!/usr/bin/env ruby
# frozen_string_literal: true

require "bcrypt"
require "io/console"

print "Password to hash: "
password = begin
  STDIN.noecho(&:gets)
rescue Errno::ENOTTY, IOError
  STDIN.gets
end.to_s.chomp
puts

if password.empty?
  warn "Password cannot be empty."
  exit 1
end

puts BCrypt::Password.create(password)
