source "https://rubygems.org"

# Ruby 3.0 is the floor, set by puma (>= 3.0) and dotenv (>= 3.0), with
# sinatra wanting >= 2.7.8. Stated here so bundler says "your Ruby is too
# old" outright, rather than failing as a confusing pile of unrelated gem
# resolution errors - which is what a Raspberry Pi still on Raspbian
# stretch (Ruby 2.3) gets otherwise.
ruby ">= 3.0"

gem "serialport", "~> 1.3"

gem "sinatra", ">= 3.1"
gem "rackup", ">= 2.1"
gem "puma", ">= 6.4"
gem "bcrypt", "~> 3.1"
gem "dotenv", "~> 3.1"

group :test do
  gem "minitest", ">= 5.0"
  gem "rack-test", "~> 2.1"
  gem "rake"
end
