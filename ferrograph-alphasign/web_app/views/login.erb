<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Sign in - Ferrograph Sign Control</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root { color-scheme: light dark; }
  body {
    font-family: system-ui, sans-serif;
    background: #14161a;
    color: #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    margin: 0;
  }
  form {
    background: #1e2128;
    padding: 2rem;
    border-radius: 12px;
    width: 280px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }
  h1 { font-size: 1.1rem; margin: 0 0 1.25rem; text-align: center; }
  label { display: block; font-size: 0.85rem; margin: 0.75rem 0 0.25rem; color: #aaa; }
  input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    border: 1px solid #3a3f4b;
    background: #14161a;
    color: #e8e8e8;
    font-size: 0.95rem;
  }
  button {
    width: 100%;
    margin-top: 1.25rem;
    padding: 0.6rem;
    border: none;
    border-radius: 6px;
    background: #4f8cff;
    color: white;
    font-size: 0.95rem;
    cursor: pointer;
  }
  button:hover { background: #3f7aeb; }
  .error {
    background: #4a1f24;
    color: #ffb3ba;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
  }
</style>
</head>
<body>
  <form method="post" action="/login">
    <h1>Ferrograph Sign Control</h1>
    <% if error %>
      <div class="error"><%= error %></div>
    <% end %>
    <label for="username">Username</label>
    <input type="text" id="username" name="username" autocomplete="username" required autofocus>
    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="current-password" required>
    <button type="submit">Sign in</button>
  </form>
</body>
</html>
