# Copy this to .env and fill in real values for local development:
#
#   cp .env.example .env
#
# Both serial_api and web_app load .env automatically (via the dotenv gem)
# from this file's directory - the repo root - regardless of which
# directory you start them from, so one .env here covers both services.
# Real environment variables (e.g. a systemd EnvironmentFile in production
# - see DEPLOY.md) always take priority over .env; dotenv only fills in
# values that aren't already set.
#
# .env is gitignored - never commit your real one, it contains secrets.

# --- serial_api ---

SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_BAUD=9600
# SERIAL_PARITY=none
# SERIAL_DATA_BITS=8
# SERIAL_STOP_BITS=1
# SERIAL_ADDRESS=00
# SERIAL_TYPE=Z
# SERIAL_API_BIND=127.0.0.1
# SERIAL_API_PORT=4568

# --- web_app ---

WEB_APP_USERNAME=admin
# Generate with: bin/hash_password. IMPORTANT: wrap it in single quotes -
# bcrypt hashes are full of $ characters (e.g. $2a$12$...), and the dotenv
# gem does shell-style $VAR interpolation on unquoted/double-quoted
# values, silently mangling the hash into garbage. Single-quoted values
# are left alone. Example (not a real hash):
#   WEB_APP_PASSWORD_HASH='$2a$12$abcdefghijklmnopqrstuuVWXYZ0123456789ABCDEFGHIJKLMNOPQR'
WEB_APP_PASSWORD_HASH=
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SESSION_SECRET=
SERIAL_API_URL=http://127.0.0.1:4568
# Only for local http:// testing - leave unset (defaults to true) once
# served over Tailscale HTTPS, so the session cookie is never sent over
# an unencrypted connection.
WEB_APP_SECURE_COOKIES=false
# WEB_APP_ALLOWED_HOSTS=localhost,127.0.0.1
