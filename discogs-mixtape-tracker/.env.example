# Discogs personal access token — https://www.discogs.com/settings/developers
# Raises the rate limit from 25 req/min (unauthenticated) to 60 req/min.
DISCOGS_TOKEN=

# Path to a Google service-account JSON key with the Sheets API (and Drive
# API, if you want the tool to create new spreadsheets) enabled.
# Share the target spreadsheet with the service account's client_email,
# or set SHARE_WITH so a newly-created spreadsheet gets shared with you.
GOOGLE_APPLICATION_CREDENTIALS=
SHARE_WITH=
